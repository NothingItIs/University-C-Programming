{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                ".",
                "-B",
                "build",
                "-DACTIVE_SOURCE=${file}"
            ],
            "windows": {
                "args": [
                    "-S",
                    ".",
                    "-B",
                    "build",
                    "-G",
                    "MinGW Makefiles",
                    "-DACTIVE_SOURCE=${file}"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: CMake build project",
            "command": "cmake",
            "args": [
                "--build",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Configure",
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build the complete project with CMake"
        }
    ]
}